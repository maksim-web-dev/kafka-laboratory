{
  "type": "record",
  "name": "PaymentRefundedEvent",
  "namespace": "com.kafkalab.avro",
  "doc": "Saga compensation action: payment refunded after inventory failure",
  "fields": [
    {"name": "eventVersion", "type": "string", "default": "1.0"},
